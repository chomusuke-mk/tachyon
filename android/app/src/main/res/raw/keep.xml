<?xml version="1.0" encoding="utf-8"?>
<!-- Resources referenced by name or dynamically at runtime by audio_service
     and AndroidX Media (e.g. getIdentifier, MediaStyle RemoteViews).
     Must not be stripped by the R8 resource shrinker in release builds. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@drawable/audio_service_*,@layout/notification_*,@drawable/notification_*,@dimen/notification_*,@dimen/compat_notification_*,@style/TextAppearance_Compat_Notification*,@style/Widget_Compat_Notification*,@color/notification_*"
    tools:shrinkMode="safe" />
