    <authors>Chomusuke</authors>
    <projectUrl>https://github.com/chomusuke-mk/tachyon</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/chomusuke-mk/tachyon@__APP_VERSION__/assets/icon/icon.webp</iconUrl>
