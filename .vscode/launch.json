{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tachyon debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    },
    {
      "name": "tachyon profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": [
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    },
    {
      "name": "tachyon release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    }
  ]
}
